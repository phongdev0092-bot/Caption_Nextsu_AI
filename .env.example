# Feature flag: dat true khi muon bat auto import
AUTO_IMPORT_ENABLED=false

# Chuoi ket noi Supabase PostgreSQL (port 6543 transaction pooler)
SUPABASE_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Bang dich cho dataset tk (giai doan test de tk_auto_test)
AUTO_IMPORT_TK_TABLE=tk_auto_test

# Danh sach doi tac cho phep (phan tach bang dau phay)
AUTO_IMPORT_PARTNERS=Phương Nam-01

# Tuy chon ghi de thong tin dang nhap Inside (neu khong dat se doc config.json)
# INSIDE_USERNAME=
# INSIDE_PASSWORD=
# INSIDE_TOTP_SECRET=
# INSIDE_USE_OTP=true
